generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  password     String
  displayName  String
  role         String
  createdAt    DateTime @default(now())
  orders       Order[]
}

// ─── Restaurant Models ───────────────────────────────────────────

model TableSection {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#f59e0b")
  sortOrder Int      @default(0)
  tables    Table[]
  createdAt DateTime @default(now())
}

model Table {
  id        String        @id @default(cuid())
  number    Int           @unique
  name      String?
  sectionId String?
  section   TableSection? @relation(fields: [sectionId], references: [id])
  shape     String        @default("square") // square | round | rectangle
  seats     Int           @default(4)
  posX      Float         @default(100)
  posY      Float         @default(100)
  width     Float         @default(120)
  height    Float         @default(120)
  rotation  Float         @default(0)
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  emoji     String     @default("🍽️")
  sortOrder Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  description String       @default("")
  price       Float
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  available   Boolean      @default(true)
  sortOrder   Int          @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id])
  status        String      @default("open") // open | billed | paid | cancelled
  guestCount    Int         @default(1)
  items         OrderItem[]
  notes         String      @default("")
  openedBy      String
  openedByName  String
  closedAt      DateTime?
  total         Float       @default(0)
  cashReceived  Float?
  change        Float?
  paymentMethod String?     // cash | card | mixed
  folio         Int?        // sequential ticket number
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  operator      User        @relation(fields: [openedBy], references: [username])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])
  name       String
  unitPrice  Float
  quantity   Int
  notes      String    @default("")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model OrderSequence {
  id    String @id @default("singleton")
  value Int    @default(0)
}
